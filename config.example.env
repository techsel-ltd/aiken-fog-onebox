# ── aiken-fog-onebox configuration ───────────────────────────────────────────
# Copy to config.env and edit for your site.  Every script sources this file.
# The values below are EXAMPLES using the 10.10.0.0/24 documentation range —
# replace them with your own. Nothing here is secret; do not put passwords here.

# --- Interfaces on the AWB host -----------------------------------------------
PXE_IFACE=eth1            # NIC facing the imaging/PXE segment (clients boot here)
UPLINK_IFACE=eth0         # NIC with the host's default route (internet/management)
BRIDGE=br-pxe             # Linux bridge this project creates over PXE_IFACE

# --- Addressing on the PXE segment --------------------------------------------
AWB_HOST_IP=10.10.0.1     # the AWB host's address on the PXE segment
PXE_CIDR=10.10.0.0/24
PXE_NETMASK=255.255.255.0
PXE_BROADCAST=10.10.0.255
DHCP_RANGE_START=10.10.0.10
DHCP_RANGE_END=10.10.0.200
FOG_VM_IP=10.10.0.2       # the FOG guest's address on the PXE segment (outside the DHCP range)

# --- AWB (Aiken WorkBench) paths on the host ----------------------------------
# These match a typical AWB install; adjust to yours. Confirm with:
#   grep TFTP_DIRECTORY /etc/default/tftpd-hpa   and   cat /etc/exports
TFTP_ROOT=/awbcboot                 # AWB's TFTP root (in.tftpd serves this)
AWB_NFS_EXPORT=/awbclient           # AWB diskless-root NFS export
AWB_KERNEL=boot/vmlinuz             # kernel path under TFTP_ROOT
AWB_INITRD=boot/initrd.img-awb      # initrd path under TFTP_ROOT
AWB_CMDLINE_EXTRA="quiet"           # any extra kernel args your AWB build needs

# --- FOG guest ----------------------------------------------------------------
FOG_VM_NAME=fog
FOG_VM_VCPUS=2
FOG_VM_RAM_MB=4096
FOG_VM_DISK_GB=40         # the guest's ROOT disk. If FOG_IMAGES_ZVOL is set below,
                          # /images lives there instead and this can stay small.
LIBVIRT_NAT_NET=default             # libvirt NAT network used as the guest's install uplink
GUEST_SSH_PUBKEY=~/.ssh/id_ed25519.pub   # public key injected into the guest via cloud-init

# Pin the image to a DATED directory, not latest/ — latest/ moves, and the
# checksum below would then fail. Update the URL and the hash together; the
# hash comes from SHA512SUMS in the same directory.
DEBIAN_IMAGE_URL=https://cloud.debian.org/images/cloud/bookworm/20260821-2577/debian-12-genericcloud-amd64-20260821-2577.qcow2
DEBIAN_IMAGE_SHA512=c602f42a374c097bafcbc77c2d034fb06cb8a831d791bcbaa5d043f029874b0c32d41cb72ba8b6d50ccfd64c9b4b0dc9ade5b6e4065712f3eb152338e532721f

FOG_BRANCH=1.5.10.2253    # FOG git tag/branch to install
FOG_COMMIT=9f3b5a8960aa840bda9876a2bda3ddb03d71328e   # optional but recommended:
                          # the exact commit FOG_BRANCH must resolve to. A tag can be
                          # moved; a commit id cannot. Leave unset to skip the check.

# Optional: pin the guest MACs instead of randomising them. Encoding the guest's
# address in the last three bytes lets `virsh domiflist` read the IP back without
# logging in. Unset = random, as before.
#FOG_SVC_MAC=52:54:00:0a:0a:02      # e.g. 0a:0a:02 for 10.10.0.2
#FOG_UPLINK_MAC=52:54:00:aa:00:02

# Optional: a dedicated block device for FOG's /images (ZFS zvol, LVM LV, whole
# disk...). Attached as the guest's vdb; format and mount it at /images before
# running 40-install-fog.sh. Unset = everything on the single root disk.
# A block device is used rather than an NFS mount from the host because FOG must
# itself NFS-export /images to the imaging clients — re-exporting an NFS mount
# needs fsid= everywhere and refuses file locks outright.
#FOG_IMAGES_ZVOL=/dev/zvol/tank/fog

# --- HTTP boot ----------------------------------------------------------------
HTTP_PORT=8080            # lighttpd port for kernel/initrd; 8080 avoids clashing
                          # with an HTTP server AWB may already run on :80

# --- Boot menu ----------------------------------------------------------------
MENU_TITLE="Network boot menu"   # heading shown on the iPXE menu
MENU_TIMEOUT_MS=5000             # ms before the default (AWB) boots unattended
