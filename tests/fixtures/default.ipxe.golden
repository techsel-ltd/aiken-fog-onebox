#!ipxe
# Rendered by scripts/50-setup-menu.sh into ${TFTP_ROOT}/default.ipxe
# NOTE: the filename MUST be default.ipxe — FOG's iPXE binaries embed
#   chain tftp://${next-server}/default.ipxe
# and ignore the DHCP filename on their second pass. See docs/TROUBLESHOOTING.md.
set awb-server 10.10.0.1
set fog-server 10.10.0.2
set http-port  8080

:start
menu Network boot menu
item --gap -- --------------- imaging ---------------
item awb     Aiken WorkBench
item fog     FOG Project
item --gap -- ---------------- other ----------------
item local   Boot from local disk
item shell   iPXE shell
item reboot  Reboot
choose --timeout 5000 --default awb target && goto ${target}
goto awb

:awb
# iPXE loads the AWB kernel/initrd directly (no grub). Served over HTTP for speed.
# WARNING: this line is a hand-mirror of AWB's grub.cfg — if AWB ships a new
# kernel or changes its cmdline, re-sync this entry or AWB boots stale/broken.
kernel http://${awb-server}:${http-port}/boot/vmlinuz root=/dev/nfs nfsroot=${awb-server}:/awbclient ip=dhcp rw quiet --
initrd http://${awb-server}:${http-port}/boot/initrd.img-awb
boot || goto failed

:fog
params
param mac0 ${net0/mac}
param arch ${buildarch}
param platform ${platform}
param sysuuid ${uuid}
chain -ar http://${fog-server}/fog/service/ipxe/boot.php##params || goto failed

:local
sanboot --no-describe --drive 0x80 || goto failed
:shell
shell || goto start
:reboot
reboot
:failed
echo Boot failed.
prompt --timeout 10000 Press a key for the iPXE shell
shell
